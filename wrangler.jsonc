{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aria-ai",
  "main": "worker-entry.js",
  "compatibility_date": "2026-08-20",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aria-ai-db",
      "database_id": "4aaec952-16d6-44a7-a125-d7ccdcac26de"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ]
}
